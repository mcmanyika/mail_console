# =============================================================================
# Mail Console — environment variables. Copy to .env.local and fill in.
# NEVER commit real values. Only NEXT_PUBLIC_* vars are exposed to the browser.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo mode ---------------------------------------------------------------
# true  => the MOCK Resend adapter is always used. No real email is ever sent,
#          no network calls to Resend are made (safe with seed.sql demo data).
# false => the live adapter is used (requires RESEND_API_KEY).
# If RESEND_API_KEY is missing the app also falls back to the mock adapter.
DEMO_MODE=true

# --- Supabase ----------------------------------------------------------------
# Local (supabase start prints these):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (live mode only) -------------------------------------------------
RESEND_API_KEY=
# Signing secret of the Resend webhook endpoint (starts with whsec_).
RESEND_WEBHOOK_SECRET=
# Label stored with webhook events (supports multiple Resend accounts later).
RESEND_ACCOUNT_LABEL=default

# --- OpenAI (optional — inbox AI assist) -------------------------------------
# SERVER ONLY. When set, workspaces can enable Summarize / Suggest reply / Improve.
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# --- Secrets -----------------------------------------------------------------
# HMAC pepper for hashing API keys + invitation tokens. REQUIRED in production
# (>= 32 random chars, e.g. `openssl rand -base64 48`). Changing it invalidates
# every issued key/invite. Dev fallback: mail-console-dev-pepper (matches seed).
API_KEY_PEPPER=mail-console-dev-pepper-change-me
# Shared secret for the outbox worker endpoint (Authorization: Bearer <secret>),
# e.g. called by Vercel Cron / a scheduler.
CRON_SECRET=

# --- Tuning (optional) -------------------------------------------------------
# Per-API-key request limit for POST /api/v1/emails (requests per minute).
API_RATE_LIMIT_PER_MINUTE=60
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_LEASE_SECONDS=120
MAX_ATTACHMENT_BYTES=26214400
